---
import type { SimpleIcon } from 'simple-icons';

interface Props {
  icon: SimpleIcon | 'mail' | 'arrow';
  class?: string;
}

const { icon, class: className = 'size-5' } = Astro.props;
---

{
  icon === 'mail' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className} aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m3.5 6.5 8.5 6.5 8.5-6.5" />
    </svg>
  ) : icon === 'arrow' ? (
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className} aria-hidden="true">
      <path d="M7 17 17 7M8 7h9v9" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
      <path d={icon.path} />
    </svg>
  )
}
