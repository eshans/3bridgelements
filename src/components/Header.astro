---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';

const links = [
  { href: '/', label: 'Home', hideOnMobile: true },
  { href: '/releases/', label: 'Releases' },
  { href: '/artists/', label: 'Artists' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isHome = path === '/';
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color] duration-500 border-b border-transparent [&.is-scrolled]:border-white/5 [&.is-scrolled]:bg-ink/60 [&.is-scrolled]:backdrop-blur-xl"
  style="view-transition-name: site-header"
>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:h-20 sm:px-8">
    <a
      href="/"
      class:list={['shrink-0 transition-opacity duration-500', isHome && 'sm:opacity-0 sm:pointer-events-none [.is-scrolled_&]:opacity-100 [.is-scrolled_&]:pointer-events-auto']}
      aria-label="3Bridge Elements home"
    >
      <Image src={logo} alt="" width={120} class="h-auto w-[76px] sm:w-[104px]" loading="eager" />
    </a>

    <nav aria-label="Main">
      <ul class="flex items-center gap-4 sm:gap-9">
        {
          links.map(({ href, label, hideOnMobile }) => (
            <li class:list={[hideOnMobile && 'hidden sm:block']}>
              <a
                href={href}
                aria-current={path === href ? 'page' : undefined}
                class="link-underline pb-1 text-[0.66rem] font-medium tracking-[0.16em] sm:text-[0.72rem] sm:tracking-[0.24em] text-white/70 uppercase transition-colors hover:text-white aria-[current=page]:text-white"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
