---
import { site, socials } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-ink/70 backdrop-blur-xl">
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 py-14 sm:px-8 md:flex-row md:items-end md:justify-between">
    <div class="space-y-3">
      <p class="display text-2xl">3Bridge Elements</p>
      <p class="max-w-xs text-sm text-white/50">
        The downtempo &amp; ambient imprint of 3Bridge Records.
      </p>
    </div>

    <div class="space-y-5 md:text-right">
      <ul class="flex flex-wrap gap-1 md:justify-end">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.name}
                class="grid size-11 place-items-center rounded-full text-white/55 transition hover:bg-white/10 hover:text-white"
              >
                <Icon icon={s.icon} class="size-[18px]" />
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${site.email}`}
            aria-label="Email"
            class="grid size-11 place-items-center rounded-full text-white/55 transition hover:bg-white/10 hover:text-white"
          >
            <Icon icon="mail" class="size-5" />
          </a>
        </li>
      </ul>
      <p class="text-xs tracking-wide text-white/35">© {year} 3Bridge Elements</p>
    </div>
  </div>
</footer>
