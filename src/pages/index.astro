---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import Icon from '../components/Icon.astro';
import logo from '../assets/brand/logo.png';
import { artists, releases, socials } from '../data/site';

const latest = releases.slice(0, 4);
const spotify = socials.find((s) => s.name === 'Spotify')!;
---

<Layout video="/video/bigclouds.mp4" dim={0.35}>
  <!-- Hero -->
  <section class="relative grid min-h-svh place-items-center px-4 sm:px-8">
    <div class="flex flex-col items-center text-center">
      <p class="eyebrow mb-10" data-reveal style="--d:200ms">Downtempo · Ambient · Cinematic</p>
      <h1 data-reveal style="--d:450ms">
        <span class="sr-only">3Bridge Elements</span>
        <Image
          src={logo}
          alt=""
          widths={[320, 500]}
          sizes="(min-width: 640px) 500px, 78vw"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-[78vw] max-w-[500px] drop-shadow-[0_10px_40px_rgba(0,0,0,0.5)]"
        />
      </h1>
      <p class="mt-10 max-w-md text-base text-white/70 sm:text-lg" data-reveal style="--d:750ms">
        Music for slow hours and wide horizons. An imprint of 3Bridge Records.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3" data-reveal style="--d:950ms">
        <a
          href="/releases/"
          class="rounded-full bg-white px-6 py-3 text-sm font-medium text-ink transition hover:bg-mist"
        >
          Explore releases
        </a>
        <a
          href={spotify.href}
          target="_blank"
          rel="noopener"
          class="glass inline-flex items-center gap-2.5 rounded-full px-6 py-3 text-sm font-medium text-white transition hover:bg-white/10"
        >
          <Icon icon={spotify.icon} class="size-4" />
          Listen on Spotify
        </a>
      </div>
    </div>

    <a
      href="#about"
      class="absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 text-white/45 transition hover:text-white"
      aria-label="Scroll to about"
    >
      <span class="text-[0.62rem] tracking-[0.32em] uppercase">Scroll</span>
      <span class="relative h-10 w-px overflow-hidden bg-white/15">
        <span class="absolute inset-x-0 top-0 h-1/2 bg-white/80 motion-safe:animate-[scrollcue_2.2s_ease-in-out_infinite]"></span>
      </span>
    </a>
  </section>

  <!-- About -->
  <section id="about" class="mx-auto max-w-5xl scroll-mt-24 px-4 py-28 sm:px-8 sm:py-40">
    <p class="eyebrow mb-8" data-reveal>About the label</p>
    <p class="display text-[1.9rem] leading-[1.25] sm:text-5xl sm:leading-[1.15]" data-reveal style="--d:100ms">
      Founded by Greg Cuoco and Eric Shans, 3Bridge Elements is the home for the
      <em class="text-mist italic">downtempo</em> and <em class="text-mist italic">ambient</em> sides of electronic music.
    </p>
    <div class="mt-12 grid gap-8 text-white/60 sm:grid-cols-2 sm:gap-16" data-reveal style="--d:200ms">
      <p>
        It was always an idea from the moment Greg and Eric started working together on 3Bridge Records. Now it’s a
        reality, a place for slower tempos, deeper textures and music made for listening.
      </p>
      <p>
        Every release is available on all major retailers and streaming services. Pull up a chair, turn it up, and
        please enjoy.
      </p>
    </div>
  </section>

  <!-- Latest releases -->
  <section class="mx-auto max-w-7xl px-4 pb-28 sm:px-8 sm:pb-40">
    <div class="mb-12 flex items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow mb-4">Latest</p>
        <h2 class="display text-4xl sm:text-5xl">New releases</h2>
      </div>
      <a href="/releases/" class="link-underline hidden pb-1 text-sm text-white/70 hover:text-white sm:block">
        All {releases.length} releases →
      </a>
    </div>
    <div class="grid grid-cols-2 gap-x-5 gap-y-10 lg:grid-cols-4 lg:gap-x-8">
      {latest.map((release, i) => <ReleaseCard release={release} delay={i * 90} />)}
    </div>
    <a href="/releases/" class="mt-12 block text-center text-sm text-white/70 underline-offset-4 hover:underline sm:hidden">
      All {releases.length} releases →
    </a>
  </section>

  <!-- Roster -->
  <section class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-4 py-28 sm:px-8 sm:py-36">
      <p class="eyebrow mb-10" data-reveal>The roster</p>
      <ul class="divide-y divide-white/10 border-y border-white/10">
        {
          artists.map((artist, i) => (
            <li data-reveal style={`--d:${i * 60}ms`}>
              <a
                href={`/artists/#${artist.slug}`}
                class="group flex items-baseline justify-between gap-6 py-6 sm:py-8"
              >
                <span class="display text-3xl transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:translate-x-3 sm:text-6xl">
                  {artist.name}
                </span>
                <span class="flex items-center gap-3 text-sm text-white/40 transition-colors group-hover:text-white">
                  {artist.aka && <span class="hidden sm:inline">{artist.aka}</span>}
                  <Icon icon="arrow" class="size-5 transition-transform duration-500 group-hover:rotate-45" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>

<style is:global>
  @keyframes scrollcue {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(200%); }
  }
</style>
