---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Icon from '../components/Icon.astro';
import { artists, releasesBy } from '../data/site';
---

<Layout title="Artists" video="/video/fog.mp4" dim={0.55}>
  <PageHeading eyebrow={`Roster · ${artists.length} artists`} title="Artists">
    <p>Producers and DJs from New York and beyond, exploring the quieter end of electronic music.</p>
  </PageHeading>

  <section class="mx-auto max-w-7xl px-4 pb-32 sm:px-8">
    <ol class="border-t border-white/10">
      {
        artists.map((artist, i) => {
          const discography = releasesBy(artist.name);
          return (
            <li id={artist.slug} class="scroll-mt-28 border-b border-white/10 py-14 sm:py-20">
              <article class="grid gap-8 md:grid-cols-[220px_1fr] md:gap-16 lg:grid-cols-[260px_1fr_220px]">
                <div data-reveal>
                  <p class="mb-5 font-mono text-xs text-white/35">{String(i + 1).padStart(2, '0')}</p>
                  <div class="aspect-[5/4] w-44 overflow-hidden rounded-sm ring-1 ring-white/10 md:w-full">
                    <Image
                      src={artist.photo}
                      alt={`Portrait of ${artist.name}`}
                      widths={[250]}
                      sizes="250px"
                      class="h-full w-full object-cover grayscale transition duration-700 hover:grayscale-0"
                    />
                  </div>
                </div>

                <div data-reveal style="--d:100ms">
                  <h2 class="display text-4xl sm:text-6xl">{artist.name}</h2>
                  {artist.aka && <p class="mt-3 text-sm tracking-wide text-white/45">aka {artist.aka}</p>}
                  <p class="mt-6 max-w-2xl leading-relaxed text-white/70">{artist.bio}</p>
                  <a
                    href={artist.href}
                    target="_blank"
                    rel="noopener"
                    class="link-underline mt-8 inline-flex items-center gap-2 pb-1 text-sm text-white/80 hover:text-white"
                  >
                    Follow {artist.name}
                    <Icon icon="arrow" class="size-4" />
                  </a>
                </div>

                {discography.length > 0 && (
                  <div data-reveal style="--d:200ms" class="md:col-start-2 lg:col-start-auto">
                    <p class="eyebrow mb-5">On the label</p>
                    <ul class="space-y-3">
                      {discography.map((r) => (
                        <li>
                          <a href={r.href} target="_blank" rel="noopener" class="group flex items-center gap-3">
                            <Image
                              src={r.cover}
                              alt=""
                              widths={[96]}
                              sizes="48px"
                              class="size-12 shrink-0 rounded-sm ring-1 ring-white/10"
                            />
                            <span class="text-sm text-white/65 transition-colors group-hover:text-white">
                              {r.title}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </article>
            </li>
          );
        })
      }
    </ol>
  </section>
</Layout>
