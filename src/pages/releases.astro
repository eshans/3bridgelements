---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import ReleaseCard from '../components/ReleaseCard.astro';
import { releases } from '../data/site';
---

<Layout title="Releases" video="pretty-sky" dim={0.5}>
  <PageHeading eyebrow={`Catalog · ${releases.length} releases`} title="Releases">
    <p>EPs, albums and compilations from the label. Available on all major retailers and streaming services.</p>
  </PageHeading>

  <section class="mx-auto max-w-7xl px-4 pb-32 sm:px-8">
    <div class="grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3 lg:grid-cols-4 lg:gap-x-8 lg:gap-y-16">
      {releases.map((release, i) => <ReleaseCard release={release} delay={(i % 4) * 90} eager={i < 4} />)}
    </div>
  </section>
</Layout>
